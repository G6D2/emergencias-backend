{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Emergencias Backend",
    "description": "CityPass+ — módulo de Emergencias y Seguridad.\n\nPrimera entrega (AUTH_MODE=local):\n1. POST Dev Login → guarda accessToken\n2. Health\n3. Trigger Panic Button\n4. Get / Cancel\n\nCon IdP real: pegá el token del Grupo 2 en accessToken.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "emergencyId",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET Health",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Chequea si el servicio está vivo y el estado de Kafka. Público (sin JWT)."
          }
        }
      ]
    },
    {
      "name": "Dev Auth (AUTH_MODE=local)",
      "item": [
        {
          "name": "POST Dev Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.access_token) {",
                  "    pm.collectionVariables.set('accessToken', body.access_token);",
                  "    pm.environment.set('accessToken', body.access_token);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sub\": \"U000042\",\n  \"preferred_username\": \"jperez\",\n  \"groups\": [\"citizen\"]\n}"
            },
            "url": "{{baseUrl}}/auth/dev/login",
            "description": "Ciudadano: activar pánico y cancelar propias emergencias. Guarda accessToken."
          }
        },
        {
          "name": "POST Dev Login (dispatcher)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.access_token) {",
                  "    pm.collectionVariables.set('accessToken', body.access_token);",
                  "    pm.environment.set('accessToken', body.access_token);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sub\": \"U000999\",\n  \"preferred_username\": \"operador1\",\n  \"groups\": [\"dispatcher\"]\n}"
            },
            "url": "{{baseUrl}}/auth/dev/login",
            "description": "Dispatcher: ver cualquier emergencia (GET). No puede activar pánico ni cancelar."
          }
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "GET Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/user",
            "description": "Devuelve sub, groups y username del JWT autenticado."
          }
        }
      ]
    },
    {
      "name": "Panic Button",
      "item": [
        {
          "name": "POST Trigger Panic Button",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.emergencyId) {",
                  "    pm.collectionVariables.set('emergencyId', body.emergencyId);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"location\": {\n    \"latitude\": -34.6037,\n    \"longitude\": -58.3816\n  },\n  \"description\": \"Necesito ayuda inmediata\",\n  \"severity\": \"critical\"\n}"
            },
            "url": "{{baseUrl}}/api/panic-button",
            "description": "Crea una emergency en status PENDING. El userId sale del JWT (sub). Publica en Kafka.\nGuarda `emergencyId` en la variable de colección."
          }
        },
        {
          "name": "POST Trigger Panic Button (401 - no token)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"location\": {\n    \"latitude\": -34.6037,\n    \"longitude\": -58.3816\n  }\n}"
            },
            "url": "{{baseUrl}}/api/panic-button",
            "description": "Esperado: 401 UnauthorizedError."
          }
        },
        {
          "name": "POST Trigger Panic Button (400 - missing fields)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Falta location\"\n}"
            },
            "url": "{{baseUrl}}/api/panic-button",
            "description": "Esperado: 400 ValidationError."
          }
        },
        {
          "name": "GET Panic Button by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/panic-button/{{emergencyId}}",
            "description": "Usa el emergencyId guardado por el POST."
          }
        },
        {
          "name": "GET Panic Button (404 - not found)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/panic-button/00000000-0000-0000-0000-000000000000",
            "description": "Esperado: 404 NotFoundError."
          }
        }
      ]
    },
    {
      "name": "Emergencies",
      "item": [
        {
          "name": "GET List Emergencies",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/emergencies?status=PENDING,VALIDATED&page=1&limit=20&sortBy=priority",
            "description": "Lista emergencias paginadas. Filtros soportados: status, severity, from, to, assignedOfficerId, type, page, limit, sortBy, order."
          }
        },
        {
          "name": "PATCH Cancel Emergency",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Falsa alarma\"\n}"
            },
            "url": "{{baseUrl}}/api/emergencies/{{emergencyId}}/cancel",
            "description": "Cancela solo si status es PENDING o VALIDATED y el usuario es el dueño. El actor sale del JWT (sub). Esperado: 200, status CANCELLED."
          }
        },
        {
          "name": "PATCH Cancel Emergency (409 - already cancelled)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Segundo intento\"\n}"
            },
            "url": "{{baseUrl}}/api/emergencies/{{emergencyId}}/cancel",
            "description": "Correr después del cancel exitoso. Esperado: 409 ConflictError."
          }
        },
        {
          "name": "PATCH Cancel Emergency (404 - not found)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"No existe\"\n}"
            },
            "url": "{{baseUrl}}/api/emergencies/00000000-0000-0000-0000-000000000000/cancel",
            "description": "Esperado: 404 NotFoundError."
          }
        },
        {
          "name": "PATCH Validate Emergency",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/api/emergencies/{{emergencyId}}/validate",
            "description": "Dispatcher: PENDING → VALIDATED."
          }
        },
        {
          "name": "PATCH Discard Emergency",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Falsa alarma / prueba\"\n}"
            },
            "url": "{{baseUrl}}/api/emergencies/{{emergencyId}}/discard",
            "description": "Dispatcher: PENDING → DISCARDED. Motivo obligatorio."
          }
        },
        {
          "name": "PATCH Assign Officer",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"officerId\": \"of-001\"\n}"
            },
            "url": "{{baseUrl}}/api/emergencies/{{emergencyId}}/assign",
            "description": "Dispatcher: VALIDATED → DISPATCHED. Oficial debe estar disponible."
          }
        }
      ]
    },
    {
      "name": "Officers",
      "item": [
        {
          "name": "GET List Officers",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/officers",
            "description": "Catálogo de oficiales (dispatcher). Query opcional: ?status=disponible"
          }
        },
        {
          "name": "GET List Officers (disponible)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/officers?status=disponible",
            "description": "Solo oficiales disponibles para asignar."
          }
        }
      ]
    }
  ]
}
