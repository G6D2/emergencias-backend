{
  "name": "emergencias-backend",
  "version": "0.1.0",
  "description": "Backend para módulo de Emergencias y Seguridad - CityPass+",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "node scripts/migrate.js migrate",
    "migrate:info": "node scripts/migrate.js info",
    "security:anonymize-locations": "node scripts/anonymize-locations.js",
    "seed": "node scripts/seed.js",
    "test": "jest --coverage",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "security:anonymize-undecryptable": "node scripts/anonymize-locations.js --undecryptable"
  },
  "keywords": [
    "emergencies",
    "panic-button",
    "security",
    "citypass"
  ],
  "author": "Grupo 6 - Emergencias y Seguridad",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jose": "^4.15.9",
    "kafkajs": "^2.2.4",
    "pg": "^8.13.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.integration\\.test\\.js$"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js",
      "!src/tests/**",
      "!src/swagger.js",
      "!src/db/migrate.js"
    ],
    "coverageReporters": ["text", "lcov", "html"],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "functions": 80,
        "branches": 80,
        "statements": 80
      }
    }
  }
}
