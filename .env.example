# Plantilla de variables de entorno. Están todas las que lee el código
# (src/, scripts/ y el setup de tests). Las comentadas son opcionales y el
# valor que muestran es el default del código, salvo que se aclare otra cosa.
# Nunca pegues acá secretos reales: .env no se commitea, este archivo sí.

# Server
# production: HSTS + redirect a HTTPS, CORS estricto y dev login estricto.
# Con AUTH_MODE=local exige además ALLOW_LOCAL_AUTH=true (con hybrid, no).
NODE_ENV=development
# Cambiar si 3000/3001 están ocupados en tu máquina
PORT=3000

# -----------------------------------------------------------------------------
# Database — elegí UNA de las dos opciones
# -----------------------------------------------------------------------------

# Opción A — Neon (recomendado para equipo / CI-CD remoto)
# Dashboard Neon → Connect → connection string URI
# Docker: solo hace falta kafka + zookeeper (postgres lo da Neon)
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_SSL=true

# Opción B — Postgres local (docker-compose up -d postgres)
# Puerto 5434 para no chocar con un Postgres de Windows en 5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/emergencias_dev
DATABASE_SSL=false

# NUNCA commitear la URL/password real de Neon.

# Por default el SSL no verifica el certificado. true = lo verifica.
# DATABASE_SSL_VERIFY=false
# CA en PEM (solo con DATABASE_SSL_VERIFY=true), con los \n escapados.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n..."

# Máximo de conexiones simultáneas del pool de pg. Sin límite, un pico de
# tráfico puede agotar las conexiones del Postgres compartido (Neon).
DB_POOL_MAX=10

# Solo tests de integración: base propia en vez del contenedor efímero.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/emergencias_test
# Tiene que ser local (los tests borran filas). Una base remota descartable,
# solo con ALLOW_REMOTE_TEST_DB=true (ver src/tests/setup/test-db-guard.js).
# ALLOW_REMOTE_TEST_DB=false

# Flyway (npm run migrate): solo para una base que ya tiene schema sin
# historial de Flyway. No usar en una base nueva (el CD no lo setea a propósito).
# FLYWAY_BASELINE_ON_MIGRATE=true
# FLYWAY_BASELINE_VERSION=<última versión ya aplicada a mano>

# -----------------------------------------------------------------------------
# Kafka
# Backend en el host: localhost:9092 (listener PLAINTEXT_HOST) — backend dentro
# de Docker: kafka:29092 (listener PLAINTEXT, ver KAFKA_BROKER del servicio
# "backend" en docker-compose.yml). Ver README.
# -----------------------------------------------------------------------------
# false = sin broker: el server no se conecta, /health dice "disabled" y los
# eventos quedan PENDING en outbox_events (la emergencia se guarda igual). Con
# docker-compose up (kafka + zookeeper) poner true.
KAFKA_ENABLED=false
# En producción es el bus del Grupo 1: test.citypass.mrfranco.net.ar:9092
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=emergencias-backend
# El broker del Grupo 1 es SASL_SSL: en producción va en true.
# KAFKA_SSL=false

# Topics de los eventos que publica el outbox
TOPIC_PANIC_BUTTON=emergencias.boton-panico
TOPIC_EMERGENCIA_ESTADO_ACTUALIZADO=emergencias.estado-actualizado
TOPIC_EMERGENCIA_PRIORIZADA=emergencias.priorizada

# Outbox → Kafka: opt-in. Sin la variable (o con cualquier valor que no sea
# true) el outbox no publica, el producer no se conecta y los eventos quedan
# PENDING: Kafka queda solo para consumir (así corre producción hoy). Contra el
# bus del Grupo 1 tiene que quedar apagado hasta que se publique por el gateway
# (#69). Con el Kafka local de docker-compose: true.
# OUTBOX_PUBLISHER_ENABLED=true
# Piso temporal (ISO 8601 UTC): al arrancar el publisher, los PENDING creados
# antes pasan a SKIPPED en vez de publicarse. Vacío = sin filtro.
# OUTBOX_PUBLISH_SINCE=2026-11-02T00:00:00Z
# Intentos antes de marcar el evento FAILED (backoff exponencial desde 30 s).
# OUTBOX_MAX_ATTEMPTS=10
# Tope del backoff entre reintentos, en ms (default 15 min).
# OUTBOX_MAX_BACKOFF_MS=900000
# Horas que se guardan las filas PUBLISHED antes de purgarlas.
# OUTBOX_PUBLISHED_RETENTION_HOURS=168

# Listeners de eventos externos (src/listeners). true los arranca; cada uno
# necesita además su topic: sin topic, ese listener no arranca.
KAFKA_CONSUMER_ENABLED=false
# EDA_TOPIC_EVENTO_PUBLICADO=com.citypass.espacios.EventoComunitarioPublicado
# EDA_TOPIC_EVENTO_CANCELADO=com.citypass.espacios.EventoCancelado
# Cobertura preventiva desde ActividadCreada (Espacios la pasó a v3 el 14/11; v1 y v2 ya no reciben eventos).
# Sin la variable usa ese mismo topic (default del código).
# EDA_TOPIC_ACTIVIDAD_CREADA=com.citypass.espacios.ActividadCreada.v3
# Umbral de personas (default 1000 en ActividadCreada, 500 en EventoComunitarioPublicado:
# fijarlo en 1000 para que las dos reglas coincidan).
# UMBRAL_CAPACIDAD_COBERTURA_PREVENTIVA=1000
# Reclamo por ciclovía obstruida → intervención (defaults del código).
# El flujo es Reclamos → Movilidad → Emergencias: la intervención la crea la
# EmergenciaSolicitada de Movilidad. El ReclamoCreado directo es el plan B.
# EDA_TOPIC_EMERGENCIA_SOLICITADA=com.citypass.movilidad.EmergenciaSolicitada
# Pedido de asistencia por un incidente durante un viaje en bicicleta pública.
# EDA_TOPIC_EMERGENCIA_BICICLETA=com.citypass.movilidad.EmergenciaBicicleta
# EDA_TOPIC_RECLAMO_CREADO=com.citypass.reclamos.ReclamoCreado.v3
# EDA_TOPIC_RECLAMO_ACTUALIZADO=com.citypass.reclamos.ReclamoActualizado
# Quién crea la intervención: movilidad (default) | reclamo | ambos.
# Un valor que no existe frena el arranque.
# RECLAMO_INTERVENCION_DISPARADOR=movilidad
# Grupo sin offset commiteado: true (default) lee el topic desde el principio,
# false arranca en el final y pierde lo publicado mientras el servicio dormia.
# EDA_CONSUMER_FROM_BEGINNING=true
# Piso temporal (ISO 8601 con Z u offset; en el futuro no arranca): al leer
# desde el principio, los mensajes anteriores se saltean. Dejala cargada
# siempre: Kafka borra los offsets de un grupo vacío a los 7 días.
# EDA_CONSUMER_SINCE=2026-11-05T15:00:00Z
# Cobertura preventiva: capacidad desde la que se programa (default 500).
# UMBRAL_CAPACIDAD_COBERTURA_PREVENTIVA=500
# Contexto de zona (prioridad elevada cerca de un evento mientras dura):
# horas que dura si el evento llega sin fecha de fin (default 6).
# CONTEXTO_ZONA_DURACION_DEFAULT_HORAS=6
# Radio en metros alrededor del evento (default 500). Espacios no lo informa.
# CONTEXTO_ZONA_RADIO_DEFAULT_METROS=500
# Publicar EmergenciaVinculadaAContextoZona (un evento por vínculo de una
# emergencia con un contexto de zona). Solo vale "true". Apagado por default:
# se enciende cuando el tipo está registrado en el catálogo del gateway y,
# al hacerlo, se corre una vez `npm run backfill:vinculos-contexto`.
# EVENTO_VINCULO_CONTEXTO_ENABLED=false
# group.id = <prefijo>.<Listener>. Tiene que empezar con com.citypass.emergencias.
# KAFKA_CONSUMER_GROUP_PREFIX=com.citypass.emergencias

# Schema registry del gateway del Grupo 1 (Avro en formato Confluent). Sin
# usuario y contraseña usa el mismo token Bearer que el broker.
# EDA_SCHEMA_REGISTRY_URL=https://test.citypass.mrfranco.net.ar/api/v1
# EDA_SCHEMA_REGISTRY_USERNAME=
# EDA_SCHEMA_REGISTRY_PASSWORD=
# SASL/OAUTHBEARER (broker) y Bearer (registry): se activan solo si está el
# secreto. Lo pasa el Grupo 2 por canal privado, no va al repo.
# EDA_OAUTH_TOKEN_URL=https://api.citypass-login.pp.ua/oauth/token
# EDA_OAUTH_CLIENT_ID=grupo5
# EDA_OAUTH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Publisher al gateway EDA (issue #74 — OAuth2 client-credentials grupo5)
# -----------------------------------------------------------------------------
# Default 'kafka' = publica directo con KafkaService (comportamiento previo).
# 'gateway'       = publica HTTP al gateway EDA con token OAuth2 del cliente
#                   de servicio del backend. El empleado humano se persiste
#                   en el payload (data.userId / data.actor), no en el token.
# El token sale del mismo cliente OAuth2 de arriba (EDA_OAUTH_*), y el outbox
# solo publica con OUTBOX_PUBLISHER_ENABLED=true.
# EDA_PUBLISHER_MODE=kafka
# EDA_API_URL=https://test.citypass.mrfranco.net.ar

# -----------------------------------------------------------------------------
# Auth — JWT CityPass+
# AUTH_MODE=local (default, así corre producción hoy):
#   POST /auth/register  — alta email+password (tabla auth_users)
#   POST /auth/login     — login email+password
#   POST /auth/dev/login — token para un sub demo (o cualquiera, si no es estricto)
# Solo Login Federado del Grupo 2 (sin login local): AUTH_MODE=idp + IDP_*.
# Login Federado para el personal + cuentas locales para los ciudadanos:
# AUTH_MODE=hybrid (ver README > Login Federado + cuentas locales). El iss de
# cada token decide si se valida contra el JWKS del Grupo 2 o la clave local.
# hybrid no mira NODE_ENV ni ALLOW_LOCAL_AUTH.
# -----------------------------------------------------------------------------
AUTH_MODE=local

# local: issuer/audience de los tokens que emite el backend.
# idp e hybrid: los del Login Federado (obligatorios, junto con IDP_JWKS_URI).
# Contrato del Grupo 2: iss https://idp.citypass.local, audience por módulo.
IDP_ISSUER=https://idp.citypass.local
IDP_AUDIENCE=citypass-emergencias-api
IDP_MODULE=emergencias
IDP_CLOCK_TOLERANCE_SECONDS=60

# idp e hybrid: JWKS del Login Federado (solo https; http solo a localhost)
# IDP_JWKS_URI=https://api.citypass-login.pp.ua/.well-known/jwks.json

# Solo hybrid — tokens del Login Federado. Ver README para el detalle.
# true = token_use / ver obligatorios (si vienen, igual tienen que ser human / 1)
# IDP_REQUIRE_TOKEN_USE=false
# IDP_REQUIRE_TOKEN_VER=false
# Claim con el id del usuario y claim con los grupos
# IDP_SUBJECT_CLAIM=sub
# IDP_GROUPS_CLAIM=groups
# Grupo federado → grupo interno (citizen, dispatcher, officer, delegado).
# Si se define, reemplaza al default, que es:
# IDP_GROUP_MAP={"dispatcher":"dispatcher","dispatchers":"dispatcher","operador":"dispatcher","officer":"officer","delegado":"delegado","delegados":"delegado"}
# Sub federado → id interno del catálogo de oficiales (vacío por default)
# IDP_SUB_ALIASES={"U000123":"of-001"}
# iss/aud de los tokens locales en hybrid (el iss tiene que ser distinto de IDP_ISSUER)
# LOCAL_JWT_ISSUER=urn:citypass:emergencias:local
# LOCAL_JWT_AUDIENCE=citypass-emergencias-api

# local e hybrid
LOCAL_TOKEN_TTL_SECONDS=900
# Opcional: fijar clave RSA entre reinicios (PKCS#8 PEM)
# LOCAL_JWT_PRIVATE_KEY_PEM=

# AUTH_MODE=local con NODE_ENV=production no arranca sin esto (hybrid lo ignora).
# ALLOW_LOCAL_AUTH=true

# /auth/dev/login. true = solo los subs demo de la allowlist
# (src/auth/dev-login-policy.js). false = cualquier sub y groups.
# Sin definir: estricto solo con NODE_ENV=production. Producción: true.
# DEV_LOGIN_STRICT=true

# -----------------------------------------------------------------------------
# Security — datos sensibles
# -----------------------------------------------------------------------------
# Clave AES-256-GCM (32 bytes en base64). Generar: openssl rand -base64 32
LOCATION_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_base64_32

# Rotación de claves (opcional). Si se define, tiene prioridad sobre
# LOCATION_ENCRYPTION_KEY. Formato: "id:base64key,id2:base64key2".
# Todas las claves listadas se usan para DESencriptar; solo
# LOCATION_ENCRYPTION_KEY_ID se usa para encriptar filas nuevas.
# LOCATION_ENCRYPTION_KEYS=v1:REPLACE_ME,v2:REPLACE_ME
# LOCATION_ENCRYPTION_KEY_ID=v2

# Clave AES-256-GCM para lat/lng en el bus (OBLIGATORIA en prod; distinta a la de DB).
# Se comparte con consumidores (Reclamos/Analítica/etc.) por canal seguro.
# Sin ella, data.ubicacion.latitud/longitud salen null. Generar: openssl rand -base64 32
# NO reutilizar LOCATION_ENCRYPTION_KEY (el boot rechaza si son iguales).
BUS_LOCATION_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_base64_32
# Rotación (opcional): keyring + id activo (se hace trim del KEY_ID).
# BUS_LOCATION_ENCRYPTION_KEYS=v1:REPLACE_ME,v2:REPLACE_ME
# BUS_LOCATION_ENCRYPTION_KEY_ID=v1

# Retención: anonimiza lat/lng cifrados N horas después de closed_at (job en background)
LOCATION_RETENTION_HOURS=72
LOCATION_RETENTION_ENABLED=true
# LOCATION_RETENTION_INTERVAL_MS=3600000

# Minimización PII del perfil ciudadano (ciphertext + ubicaciones guardadas)
# Tras N días sin actualizar el perfil / la ubicación, se borra el ciphertext.
CITIZEN_PII_RETENTION_DAYS=90
CITIZEN_PII_RETENTION_ENABLED=true
# Sin definir usa LOCATION_RETENTION_INTERVAL_MS (o 1 h).
# CITIZEN_PII_RETENTION_INTERVAL_MS=3600000

# HSTS + redirect a HTTPS aunque NODE_ENV no sea production.
# FORCE_HTTPS=true

# -----------------------------------------------------------------------------
# Deteccion de incidentes (tarea #60/#61): agrupa emergencias cercanas del
# mismo tipo en una ventana temporal y calcula prioridad. DbscanGrouper es la
# estrategia primaria (density-clustering); RuleBasedGrouper es el fallback
# ante una falla tecnica real de DBSCAN (ver ADR-002, IncidentDetectionStrategy).
# -----------------------------------------------------------------------------
INCIDENT_DETECTION_ENABLED=true
# Radio en metros para considerar dos emergencias parte del mismo incidente.
# Compartido entre las dos estrategias: mismo radio para RuleBasedGrouper y
# como epsilon de DbscanGrouper.
INCIDENT_RADIUS_M=300
# Ventana temporal (minutos) hacia atras en la que se buscan candidatos
INCIDENT_WINDOW_MIN=15
# Ciudadanos distintos minimos para que un grupo cuente como incidente.
# Compartido entre las dos estrategias: mismo umbral para RuleBasedGrouper y
# como minPointsPerCluster de DbscanGrouper (con su propio filtro posterior
# de ciudadanos unicos reales encima, ver dbscan-grouper.js).
INCIDENT_MIN_CITIZENS=2
# Cada cuanto corre el job (ms)
INCIDENT_DETECTION_INTERVAL_MS=60000

# -----------------------------------------------------------------------------
# Keep-warm (Render plan free duerme el servicio tras 15 min sin tráfico)
# El job in-process pega a estas URLs cada KEEP_WARM_INTERVAL_MS, solo dentro
# de KEEP_WARM_WINDOWS. Vacío = no hace nada (dev). Ver README (Deploy).
# -----------------------------------------------------------------------------
# KEEP_WARM_ENABLED=true
# Producción: URL pública propia (/health) + /api/warmup del frontend
# KEEP_WARM_URLS=https://emergencias-backend-34go.onrender.com/health,https://frontend-krds.onrender.com/api/warmup
# Ventanas DOW:HH:MM-HH:MM (lun,mar,mie,jue,vie,sab,dom o 0-6) separadas por
# coma, o "always". Default: jueves en horario de clase.
# KEEP_WARM_WINDOWS=jue:17:00-23:30
# KEEP_WARM_TZ=America/Argentina/Buenos_Aires
# KEEP_WARM_INTERVAL_MS=480000

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Lista de origins permitidos, separados por coma. Sin definir:
# - fuera de producción: default http://localhost:3001
# - en producción: se EXIGE. Si falta, se loguea un warn y se permite solo
#   el frontend de Render (https://frontend-krds.onrender.com); nunca se
#   refleja el origin del request.
# CORS_ALLOWED_ORIGINS=http://localhost:3001

# -----------------------------------------------------------------------------
# Rate limiting (express-rate-limit), por IP y por minuto:
# /auth/dev/login 10, /auth/login y /auth/register 20, POST /api/panic-button 5,
# cambios en /api/citizen/* 30. false lo apaga (los tests lo apagan).
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
