# Server
NODE_ENV=development
# Cambiar si 3000/3001 están ocupados en tu máquina
PORT=3000

# -----------------------------------------------------------------------------
# Database — elegí UNA de las dos opciones
# -----------------------------------------------------------------------------

# Opción A — Neon (recomendado para equipo / CI-CD remoto)
# Dashboard Neon → Connect → connection string URI
# Docker: solo hace falta kafka + zookeeper (postgres lo da Neon)
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_SSL=true
# Post-demo: verificar cert del servidor → DATABASE_SSL_VERIFY=true
# Opcional CA PEM: DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n..."

# Opción B — Postgres local (docker-compose up -d postgres)
# Puerto 5434 para no chocar con un Postgres de Windows en 5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/emergencias_dev
DATABASE_SSL=false

# NUNCA commitear la URL/password real de Neon.

# -----------------------------------------------------------------------------
# Kafka
# Backend en el host: localhost:9092 (listener PLAINTEXT_HOST) — backend dentro
# de Docker: kafka:29092 (listener PLAINTEXT, ver KAFKA_BROKER del servicio
# "backend" en docker-compose.yml). Ver README.
# -----------------------------------------------------------------------------
# Poner en false para arrancar sin broker (Render / demo): las emergencias se
# persisten igual y el evento queda registrado en el log en vez de publicarse.
KAFKA_ENABLED=true
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=emergencias-backend

# Topics
TOPIC_PANIC_BUTTON=emergencias.boton-panico
TOPIC_EMERGENCIA_ESTADO_ACTUALIZADO=emergencias.estado-actualizado
TOPIC_EMERGENCIA_PRIORIZADA=emergencias.priorizada

# -----------------------------------------------------------------------------
# Auth — JWT CityPass+
# Primera entrega (sin Grupo 2): AUTH_MODE=local
#   POST /auth/register  — alta email+password (tabla auth_users)
#   POST /auth/login     — login email+password
#   POST /auth/dev/login — token inventando sub (tests / atajos)
# Integración IdP real: AUTH_MODE=idp + variables IDP_* del Grupo 2
# -----------------------------------------------------------------------------
AUTH_MODE=local

# Compartidos (local e idp) — mismos valores que usará el IdP real
IDP_ISSUER=https://idp.citypass.local
IDP_AUDIENCE=citypass-emergencias-api
IDP_MODULE=emergencias
IDP_CLOCK_TOLERANCE_SECONDS=60

# Solo AUTH_MODE=idp (JWKS remoto del Grupo 2)
# IDP_JWKS_URI=https://idp.citypass.local/.well-known/jwks.json

# Solo AUTH_MODE=local
LOCAL_TOKEN_TTL_SECONDS=900
# Opcional: fijar clave RSA entre reinicios (PKCS#8 PEM)
# LOCAL_JWT_PRIVATE_KEY_PEM=

# Staging deployado sin Grupo 2 (Render, etc.): AUTH_MODE=local + ALLOW_LOCAL_AUTH=true
# ALLOW_LOCAL_AUTH=true

# -----------------------------------------------------------------------------
# Security — datos sensibles
# -----------------------------------------------------------------------------
# Clave AES-256-GCM (32 bytes en base64). Generar: openssl rand -base64 32
LOCATION_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_base64_32

# Rotación de claves (opcional). Si se define, tiene prioridad sobre
# LOCATION_ENCRYPTION_KEY. Formato: "id:base64key,id2:base64key2".
# Todas las claves listadas se usan para DESencriptar; solo
# LOCATION_ENCRYPTION_KEY_ID se usa para encriptar filas nuevas.
# LOCATION_ENCRYPTION_KEYS=v1:REPLACE_ME,v2:REPLACE_ME
# LOCATION_ENCRYPTION_KEY_ID=v2

# Retención: anonimiza lat/lng cifrados N horas después de closed_at (job en background)
LOCATION_RETENTION_HOURS=72
LOCATION_RETENTION_ENABLED=true
# LOCATION_RETENTION_INTERVAL_MS=3600000

# Minimización PII del perfil ciudadano (ciphertext + ubicaciones guardadas)
# Tras N días sin actualizar el perfil / la ubicación, se borra el ciphertext.
CITIZEN_PII_RETENTION_DAYS=90
CITIZEN_PII_RETENTION_ENABLED=true
# CITIZEN_PII_RETENTION_INTERVAL_MS=3600000

# /auth/dev/login: en NODE_ENV=production solo allowlist demo (4 subs).
# Para margen en Render pre-demo: DEV_LOGIN_STRICT=false
# DEV_LOGIN_STRICT=true

# -----------------------------------------------------------------------------
# Deteccion de incidentes (tarea #60/#61): agrupa emergencias cercanas del
# mismo tipo en una ventana temporal y calcula prioridad. DbscanGrouper es la
# estrategia primaria (density-clustering); RuleBasedGrouper es el fallback
# ante una falla tecnica real de DBSCAN (ver ADR-002, IncidentDetectionStrategy).
# -----------------------------------------------------------------------------
INCIDENT_DETECTION_ENABLED=true
# Radio en metros para considerar dos emergencias parte del mismo incidente.
# Compartido entre las dos estrategias: mismo radio para RuleBasedGrouper y
# como epsilon de DbscanGrouper.
INCIDENT_RADIUS_M=300
# Ventana temporal (minutos) hacia atras en la que se buscan candidatos
INCIDENT_WINDOW_MIN=15
# Ciudadanos distintos minimos para que un grupo cuente como incidente.
# Compartido entre las dos estrategias: mismo umbral para RuleBasedGrouper y
# como minPointsPerCluster de DbscanGrouper (con su propio filtro posterior
# de ciudadanos unicos reales encima, ver dbscan-grouper.js).
INCIDENT_MIN_CITIZENS=2
# Cada cuanto corre el job (ms)
INCIDENT_DETECTION_INTERVAL_MS=60000

# -----------------------------------------------------------------------------
# Keep-warm (Render plan free duerme el servicio tras 15 min sin tráfico)
# El job in-process pega a estas URLs cada KEEP_WARM_INTERVAL_MS, solo dentro
# de KEEP_WARM_WINDOWS. Vacío = no hace nada (dev). Ver README (Deploy).
# -----------------------------------------------------------------------------
# KEEP_WARM_ENABLED=true
# Producción: URL pública propia (/health) + /api/warmup del frontend
# KEEP_WARM_URLS=https://emergencias-backend-34go.onrender.com/health,https://frontend-krds.onrender.com/api/warmup
# Ventanas DOW:HH:MM-HH:MM (lun,mar,mie,jue,vie,sab,dom o 0-6) separadas por
# coma, o "always". Default: jueves en horario de clase.
# KEEP_WARM_WINDOWS=jue:17:00-23:30
# KEEP_WARM_TZ=America/Argentina/Buenos_Aires
# KEEP_WARM_INTERVAL_MS=480000

# HTTPS: en production fuerza redirect + HSTS (Render ya termina TLS)
# FORCE_HTTPS=true

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Lista de origins permitidos, separados por coma. Sin definir:
# - fuera de producción: default http://localhost:3001
# - en producción: se EXIGE. Si falta, se loguea un warn y se permite solo
#   el frontend de Render (https://frontend-krds.onrender.com); nunca se
#   refleja el origin del request.
# CORS_ALLOWED_ORIGINS=http://localhost:3001

# -----------------------------------------------------------------------------
# Pool de conexiones (pg)
# -----------------------------------------------------------------------------
# Máximo de conexiones simultáneas del pool. Sin límite explícito, un pico de
# tráfico puede agotar las conexiones del Postgres compartido (Neon).
DB_POOL_MAX=10

# -----------------------------------------------------------------------------
# Rate limiting (express-rate-limit)
# -----------------------------------------------------------------------------
# POST /auth/dev/login: 10 req/min por IP. POST /api/panic-button: 5 req/min
# por IP. RATE_LIMIT_ENABLED=false lo apaga por completo (se usa en tests,
# que reutilizan la misma app/IP para muchos requests seguidos).
RATE_LIMIT_ENABLED=true

# -----------------------------------------------------------------------------
# Integración EDA (ADR #25) — gateway de eventos externo
# El listener consume eventos de otros namespaces y el publisher HTTP envía los
# nuestros al gateway. TODAS las variables de esta sección son opcionales:
# sin ellas el listener queda apagado y el publisher sigue usando el broker
# Kafka directo (comportamiento previo).
# -----------------------------------------------------------------------------

# -- Credenciales (grupo5 = com.citypass.emergencias)
# EDA_CLIENT_ID=grupo5
# EDA_CLIENT_SECRET=grupo5

# -- Endpoints del gateway (URLs pendientes de confirmación con el Grupo 1)
# EDA_API_URL=http://localhost:8080
# EDA_AUTH_URL=http://localhost:8083/oauth/token
# EDA_KAFKA_BROKERS=localhost:9092

# -- Publisher HTTP (ADR #25). kafka = producer directo (default, previo al PR
# del gateway publisher); gateway = POST a /api/v1/event-types/{fqn}/events.
# Solo tiene efecto cuando los TOPIC_* esten renombrados a FQN del gateway.
# EDA_PUBLISHER_MODE=kafka

# -- Consumer (listener de eventos externos). Default apagado. Para prenderlo
# en Render se necesita bootstrap servers del Grupo 1 (gateway).
# KAFKA_CONSUMER_ENABLED=false
# KAFKA_GROUP_ID=emergencias-integracion
# EDA_OWN_NAMESPACE=com.citypass.emergencias
# EDA_EXTERNAL_USER_ID=eda-bus

# -- Topics a consumir (FQN finales pendientes de confirmación con Luciano,
# Grupo 6). Si cambia el namespace de "turismo" a "espacios", solo se tocan
# estas dos variables — el código las lee por nombre.
# EDA_TOPIC_EVENTO_PUBLICADO=com.citypass.turismo.EventoComunitarioPublicado
# EDA_TOPIC_EVENTO_CANCELADO=com.citypass.turismo.EventoCancelado

# -- Umbral de capacidad por encima del cual EventoComunitarioPublicado dispara
# una cobertura preventiva (pendiente de definición con el Equipo 04).
# UMBRAL_CAPACIDAD_COBERTURA_PREVENTIVA=500
