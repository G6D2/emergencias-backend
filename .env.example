# Server
NODE_ENV=development
# Cambiar si 3000/3001 están ocupados en tu máquina
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/emergencias_dev

# Kafka
# Backend en el host: localhost:29092 — backend dentro de Docker: kafka:9092 (ver README)
KAFKA_BROKER=localhost:29092
KAFKA_CLIENT_ID=emergencias-backend

# Topics
TOPIC_PANIC_BUTTON=emergencias.boton-panico
TOPIC_EMERGENCIES=emergencias.creada

# PostgreSQL (Supabase) - Task 4: persistencia de emergencias
# Reemplazar con la connection string real de Supabase (Settings > Database > Connection string).
# NUNCA commitear la URL/password real: este archivo es solo un placeholder.
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db
DATABASE_SSL=true
